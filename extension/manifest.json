{
  "manifest_version": 3,
  "name": "TrustLens — AI Trust Score",
  "version": "0.2.0",
  "description": "AI-Powered Trust Scoring for Bengali Social Media. Right-click any post, selection, or link to check its trust score.",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": [
    "http://107.161.168.216:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
